[
  { "q": "les postes hors ligne", "resource": "devices", "filters": { "status": "offline" } },
  { "q": "postes hors ligne depuis plus de 3 jours", "resource": "devices", "filters": { "offline_since_days": 3 } },
  { "q": "postes dont le disque est utilisé à plus de 85%", "resource": "devices", "filters": { "disk_used_pct_gte": 85 } },
  { "q": "postes non assignés à un utilisateur", "resource": "devices", "filters": { "assigned": false },
    "alt": [ { "resource": "devices", "filters": { "status": "unassigned" } } ] },
  { "q": "postes sans agent Opale installé", "resource": "devices", "filters": { "has_agent": false } },
  { "q": "postes sous Windows 11", "resource": "devices", "filters": { "os_contains": "Windows 11" } },
  { "q": "postes de marque Dell", "resource": "devices", "filters": { "manufacturer": "Dell" },
    "alt": [ { "resource": "devices", "filters": { "model_contains": "Dell" } } ] },
  { "q": "postes avec un redémarrage en attente", "resource": "devices", "filters": { "pending_reboot": true } },
  { "q": "postes sans BitLocker actif", "resource": "devices", "filters": { "bitlocker_active": false },
    "alt": [ { "resource": "devices", "cross": { "failing_rule": "bitlocker_c_active" } },
             { "resource": "compliance", "filters": { "rule": "bitlocker_c_active", "status": "fail" } } ] },
  { "q": "postes actifs au cours des 7 derniers jours", "resource": "devices", "filters": { "seen_within_days": 7 } },
