  { "q": "postes assignés à Marie Durand", "resource": "devices", "filters": { "assigned_user": "Marie Durand" } },
  { "q": "postes du groupe Direction", "resource": "devices", "cross": { "in_group": "Direction" } },
  { "q": "postes avec un ticket critique ouvert", "resource": "devices", "cross": { "has_ticket": "critical" } },
  { "q": "les 10 postes vus le plus récemment", "resource": "devices", "sort": { "field": "last_seen", "dir": "desc" }, "limit": 10 },
  { "q": "postes avec moins de 8 Go de RAM", "resource": "devices", "filters": { "ram_gb_lt": 8 } },
  { "q": "postes en alerte disque critique", "resource": "devices", "filters": { "status": "critical" },
    "alt": [ { "resource": "devices", "filters": { "disk_used_pct_gte": 90 } } ] },

  { "q": "tickets ouverts", "resource": "tickets", "filters": { "is_open": true } },
  { "q": "tickets critiques", "resource": "tickets", "filters": { "priority": "critical" } },
  { "q": "tickets en cours de traitement", "resource": "tickets", "filters": { "status": "in_progress" } },
  { "q": "tickets créés cette semaine", "resource": "tickets", "filters": { "created_within_days": 7 } },
  { "q": "tickets ouverts depuis plus de 30 jours", "resource": "tickets", "filters": { "older_than_days": 30 },
    "alt": [ { "resource": "tickets", "filters": { "older_than_days": 30, "is_open": true } } ] },
  { "q": "tickets créés automatiquement", "resource": "tickets", "filters": { "is_auto": true } },
  { "q": "tickets demandés par Marie Durand", "resource": "tickets", "filters": { "requester": "Marie Durand" } },
  { "q": "tickets avec le tag VPN", "resource": "tickets", "filters": { "tag": "VPN" } },
  { "q": "tickets dont le titre parle d'imprimante", "resource": "tickets", "filters": { "title_contains": "imprimante" } },
  { "q": "tickets liés au poste PC-MARIE", "resource": "tickets", "cross": { "device_hostname": "PC-MARIE" } },
  { "q": "les tickets les plus récents", "resource": "tickets", "sort": { "field": "created_at", "dir": "desc" } },
  { "q": "tickets résolus", "resource": "tickets", "filters": { "status": "resolved" } },

  { "q": "quels postes échouent à l'antivirus Defender", "resource": "compliance", "filters": { "rule": "defender_av_active", "status": "fail" },
    "alt": [ { "resource": "devices", "cross": { "failing_rule": "defender_av_active" } } ] },
  { "q": "tous les échecs de conformité critiques", "resource": "compliance", "filters": { "status": "fail", "severity": "critical" } },
  { "q": "état de conformité de la règle BitLocker", "resource": "compliance", "filters": { "rule": "bitlocker_c_active" } },
  { "q": "postes non conformes à Windows Update", "resource": "compliance", "filters": { "rule": "windows_update_recent", "status": "fail" },
