node_modules
api/node_modules
.git
.claude
.env
agent/dist
# Sécurité : la clé privée de signature ne doit JAMAIS finir dans l'image,
# elle est montée en volume au runtime.
agent-go/keys/signing.key
# Le binaire compilé est aussi monté en volume pour permettre des updates
# sans rebuild.
agent-go/dist
# Idem pour la clé privée LAPS (et toute autre clé privée) : jamais dans le
# contexte de build, même si aucun COPY ne la vise aujourd'hui.
agent-go/keys/*.key
# Secrets et fichiers propres à une instance : .env de sous-dossiers,
# surcharges privées, installeurs générés (token agent en clair), infra VPN.
**/.env
instance-local
intune-installers
netbird
