# ── Serveur ────────────────────────────────────────────────────────────────────
PORT=3010
NODE_ENV=production

# ── Base de données ────────────────────────────────────────────────────────────
POSTGRES_DB=opale
POSTGRES_USER=opale
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db                    # nom du service Docker Compose, ou adresse IP

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://opale.example.com  # utilisé pour CORS
API_BASE_URL=/api                      # injecté dans window.ENV côté client

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
# App Registration avec permissions Application (pas déléguées) :
#   User.Read.All, Device.Read.All, DeviceManagementManagedDevices.Read.All,
#   GroupMember.Read.All
# Pour le pont mail ↔ tickets (issue #8), ajouter aussi :
#   Mail.ReadWrite   (Phase 1 + 5a — lecture polling, marquage "lu" à l'acceptation)
#   Mail.Send        (Phase 4 — envoi des réponses)
# Mail.ReadWrite est un sur-ensemble de Mail.Read — pas besoin des deux.
# Consentement admin tenant requis sur ces permissions applicatives.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── SSH ────────────────────────────────────────────────────────────────────────
# Clé privée ED25519 encodée en base64 : base64 -i ~/.ssh/id_ed25519
# Si non défini, l'API émet un warning au boot et utilise le défaut 'opale'.
SSH_USER=opale
SSH_PORT=22
SSH_PRIVATE_KEY_B64=

# ── Push notifications (PWA) ───────────────────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
# VAPID_EMAIL est REQUIS dès lors que les clés VAPID sont définies (fail-fast au boot).
# Format accepté : 'admin@example.com' ou 'mailto:admin@example.com'.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Onboarding ─────────────────────────────────────────────────────────────────
# IDs des groupes Entra à assigner lors de l'onboarding (séparés par des virgules)
ONBOARDING_BASE_GROUP_IDS=
ONBOARDING_LICENSE_GROUP_ID=

# ── Bootstrap du premier administrateur ───────────────────────────────────────
# Sur une instance sans AUCUN administrateur, le premier compte qui se connecte
# est promu automatiquement, et la promotion est tracée dans le journal d'audit.
# Renseignez cette variable pour nommer explicitement le compte autorisé à
# revendiquer le rôle — à préférer si l'URL est déjà joignable par d'autres.
OPALE_BOOTSTRAP_ADMIN_UPN=

# ── Migrations ────────────────────────────────────────────────────────────────
# Les migrations SQL sont appliquées automatiquement au démarrage de l'API,
# une fois et une seule, tracées dans la table schema_migrations.
#   OPALE_MIGRATE_ON_BOOT=false     → migration pilotée hors du boot
#                                     (`node scripts/migrate.js` en pré-déploiement)
#   OPALE_MIGRATIONS_BASELINE=NNN   → marque tout ce qui est ≤ NNN comme
#                                     appliqué SANS l'exécuter. Réservé à
#                                     l'adoption du runner sur une instance
#                                     dont le schéma est déjà à jour.
OPALE_MIGRATE_ON_BOOT=true
# OPALE_MIGRATIONS_BASELINE=

# ── Base de données : TLS ─────────────────────────────────────────────────────
# disable (défaut)  — pas de TLS. Correct si la base est sur le même hôte Docker.
# require           — TLS obligatoire, certificat non vérifié.
# verify-full       — TLS + vérification de la chaîne et du nom d'hôte.
#                     À utiliser dès que POSTGRES_HOST désigne une machine
#                     distante, sinon identifiants et données circulent en clair.
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
# POSTGRES_SSLROOTCERT=/chemin/vers/ca.pem
# POSTGRES_POOL_MAX=10

# ── Clés et chemins de l'agent ────────────────────────────────────────────────
# Défauts déduits de l'arborescence ; à ne surcharger qu'en layout personnalisé.
# AGENT_GO_DIR=/app/agent-go
# AGENT_SIGNING_KEY=/app/agent-go/keys/signing.key
# AGENT_GO_VERSION_FILE=/app/agent-go/dist/agent-version.txt
# LAPS_PRIVATE_KEY=/app/agent-go/keys/laps.key

# Durée de vie d'un token agent personnel (jours). L'agent le renouvelle seul ;
# cette borne limite la fenêtre d'exploitation d'un token dérobé sur un poste
# qui ne tourne plus.
OPALE_AGENT_TOKEN_TTL_DAYS=180

# Noms de service historiques acceptés au redémarrage d'agent (CSV, filtré sur
# [A-Za-z0-9_-]). Utile après un changement de branding.
# OPALE_LEGACY_AGENT_SERVICE_NAMES=
# Idem pour le slug User-Agent d'un agent au branding historique.
# OPALE_LEGACY_AGENT_UA_PATTERN=

# ── SSH : vérification des clés d'hôte ────────────────────────────────────────
# tofu (défaut) — l'empreinte est apprise au premier contact, toute clé
#                 différente coupe ensuite la connexion. La réinitialisation
#                 après réinstallation d'un poste se fait depuis sa fiche.
# strict        — refuse aussi le premier contact tant qu'aucune empreinte n'est
#                 enregistrée (parcs qui provisionnent l'empreinte hors bande).
OPALE_SSH_HOST_KEY_POLICY=tofu

# Connexions SSH sortantes simultanées, et durée maximale d'un script (ms).
OPALE_SSH_CONCURRENCY=10
OPALE_SCRIPT_TIMEOUT_MS=300000

# ── Pièces jointes des tickets ────────────────────────────────────────────────
# Doit pointer un volume inscriptible par l'uid 1000 (utilisateur `node`).
ATTACHMENTS_DIR=/app/data/ticket-attachments

# ── Ask Opale (recherche du parc en langage naturel) ──────────────────────────
# La clé API vit ICI et jamais dans la table settings : elle ne doit pas être
# lisible via GET /api/settings. Le fournisseur, le modèle et l'URL se
# configurent depuis Paramètres.
OPALE_ASK_API_KEY=

# ── Fournisseurs LLM : hôtes autorisés ────────────────────────────────────────
# Les URL de fournisseurs (ask, classifieur mail, assistant tickets) sont
# validées contre une allowlist d'hôtes AVANT tout appel réseau. Sans elle, un
# compte admin compromis pourrait pointer ask.url vers un hôte arbitraire et
# recevoir OPALE_ASK_API_KEY dans l'en-tête de la requête.
# Autorisés par défaut : api.anthropic.com, api.mistral.ai, ollama, localhost.
# Cette liste n'est volontairement PAS modifiable depuis l'interface.
# OPALE_LLM_ALLOWED_HOSTS=llm.interne.example

# ── Index winget (autocomplétion des noms de paquets) ─────────────────────────
# Désactivé par défaut : ~50 Mo de MSIX téléchargés et une base SQLite résidente
# en permanence dans le process API, pour du confort de saisie. La saisie
# directe d'un identifiant winget fonctionne sans.
OPALE_WINGET_INDEX=false
# WINGET_SOURCE_URL=https://cdn.winget.microsoft.com/cache/source2.msix

# ── Divers ────────────────────────────────────────────────────────────────────
# Délai de grâce à l'arrêt (ms) avant sortie forcée.
OPALE_SHUTDOWN_GRACE_MS=15000
# Désactive HSTS en production (utile si le reverse-proxy le pose déjà).
# OPALE_DISABLE_HSTS=false
