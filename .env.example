# ── Serveur ────────────────────────────────────────────────────────────────────
PORT=3010
NODE_ENV=production

# ── Base de données ────────────────────────────────────────────────────────────
POSTGRES_DB=opale
POSTGRES_USER=opale
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db                    # nom du service Docker Compose, ou adresse IP

# ── Base de données : migrations et timeouts (optionnel) ──────────────────────
# L'API applique les migrations api/migrations/*.sql en attente au démarrage,
# avant d'écouter (cf. api/migrations/MIGRATIONS.md). false = à la main.
# DB_AUTO_MIGRATE=true
# Attente max d'une connexion au pool, et durée max d'une requête (ms ; 0 = sans limite).
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=30000

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://opale.example.com  # utilisé pour CORS
API_BASE_URL=/api                      # injecté dans window.ENV côté client

# ── Reverse proxy ──────────────────────────────────────────────────────────────
# Proxy(s) de confiance pour lire l'IP client dans X-Forwarded-For (rate-limit).
# EN PRODUCTION DERRIÈRE CADDY/NGINX : À DÉFINIR (de fait obligatoire).
# Vide / false (défaut) : req.ip = IP du pair TCP — derrière le proxy, TOUS les
# clients partagent alors l'IP du proxy, donc les mêmes quotas : n'importe qui
# sur Internet peut épuiser le quota de /api/agent/exchange-token (10/min pour
# toute la flotte) et bloquer les enrôlements.
# SÛR UNIQUEMENT si le port 3010 n'est joignable QUE via le proxy : sinon un
# client qui s'y connecte en direct forge X-Forwarded-For. Le docker-compose.yml
# fourni publie 3010 sur TOUTES les interfaces ("3010:3010") : passer à
# "127.0.0.1:3010:3010" (ou filtrer 3010 au pare-feu) avant de l'activer.
# Valeurs : liste d'IP/CIDR du proxy (recommandé ; API en Docker derrière un
# proxy sur l'hôte → IP de la passerelle du bridge Docker vue par l'API, ex.
# 172.18.0.1, ou le sous-réseau du réseau compose ; pas 127.0.0.1). Éviter un
# CIDR large comme 172.16.0.0/12 : un client dont l'IP y tombe pourrait forger
# son IP derrière nginx. true et un nombre de proxies (1) sont refusés au boot :
# ils ne vérifient pas le pair TCP (usurpation, cf. GHSA-3m5p-2c4r-xxw2).
TRUST_PROXY=

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
# App Registration avec permissions Application (pas déléguées). Détail par
# fonctionnalité, appels Graph et durcissement Entra/Exchange : INSTALL.md §3.2.
#   Socle          : User.Read.All
#   Intune         : DeviceManagementManagedDevices.Read.All (import),
#                    DeviceManagementManagedDevices.PrivilegedOperations.All
#                    (bouton « Sync Intune » d'un poste)
#   Groupes Entra  : GroupMember.Read.All + Device.Read.All
#   Onboarding auto: User.ReadWrite.All (création de compte), GroupMember.ReadWrite.All
# Pour le pont mail ↔ tickets (issue #8), ajouter aussi :
#   Mail.Read        (lecture seule) ou Mail.ReadWrite (marquage "lu" + réponses
#                    threadées) — Mail.ReadWrite est un sur-ensemble de Mail.Read
#   Mail.Send        (envoi des réponses)
# Mail.* vaut pour TOUTES les boîtes du tenant : les restreindre aux boîtes du
# helpdesk (RBAC for Applications Exchange Online, cf. INSTALL.md §3.2).
# Consentement admin tenant requis sur ces permissions applicatives.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── SSH ────────────────────────────────────────────────────────────────────────
# Clé privée ED25519 encodée en base64 : base64 -i ~/.ssh/id_ed25519
# Si non défini, l'API émet un warning au boot et utilise le défaut 'opale'.
SSH_USER=opale
SSH_PORT=22
SSH_PRIVATE_KEY_B64=
# Clé d'hôte des postes : par défaut (vide) l'empreinte est apprise au premier
# accès SSH puis toute clé différente est refusée (réinitialisable par un admin
# depuis la fiche du poste). « strict » refuse aussi le premier contact : à
# réserver aux parcs dont l'empreinte est renseignée hors bande en base
# (devices.ssh_host_key_fp = le champ « SHA256:… » affiché par `ssh-keygen -lf`
# pour la clé d'hôte ed25519 du poste, avec ou sans ce préfixe). Toute autre valeur
# que « strict » ou « tofu » est signalée au démarrage et vaut « tofu ».
OPALE_SSH_HOST_KEY_POLICY=

# ── Push notifications (PWA) ───────────────────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
# VAPID_EMAIL est REQUIS dès lors que les clés VAPID sont définies (fail-fast au boot).
# Format accepté : 'admin@example.com' ou 'mailto:admin@example.com'.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Onboarding ─────────────────────────────────────────────────────────────────
# IDs des groupes Entra à assigner lors de l'onboarding (séparés par des virgules)
ONBOARDING_BASE_GROUP_IDS=
ONBOARDING_LICENSE_GROUP_ID=

# ══ Variables avancées (optionnelles) — début ═════════════════════════════════
# Lues par le code mais non requises : les défauts conviennent au layout Docker
# standard. Toutes commentées ; décommenter seulement pour surcharger.
# Référence : docs/CONFIGURATION.md §1.8.

# Pièces jointes des tickets : dossier de stockage (volume RW, écrit par l'uid
# 1000 `node` de l'image).
# ATTACHMENTS_DIR=/app/data/ticket-attachments

# Agent Go : dossier contenant dist/ (binaires, agent-version.txt) et keys/.
# Défaut : détecté automatiquement (/app/agent-go dans l'image Docker).
# AGENT_GO_DIR=/app/agent-go
# Fichier de version des binaires servis (défaut $AGENT_GO_DIR/dist/agent-version.txt).
# AGENT_GO_VERSION_FILE=/app/agent-go/dist/agent-version.txt
# CHEMIN (pas le contenu) de la clé privée ed25519 qui signe les binaires agent
# (défaut $AGENT_GO_DIR/keys/signing.key). Ne jamais coller la clé ici.
# AGENT_SIGNING_KEY=/app/agent-go/keys/signing.key
# CHEMIN de la clé privée RSA qui déchiffre les mots de passe LAPS
# (défaut $AGENT_GO_DIR/keys/laps.key).
# LAPS_PRIVATE_KEY=/app/agent-go/keys/laps.key

# Catalogue winget : URL du MSIX source de l'index (défaut : CDN Microsoft).
# WINGET_SOURCE_URL=https://cdn.winget.microsoft.com/cache/source2.msix

# Ask Opale (recherche en langage naturel) : clé API du fournisseur LLM. Le
# fournisseur, l'URL et le modèle se règlent dans les settings (ask.*). Secret.
# OPALE_ASK_API_KEY=
# Harness d'éval hors ligne uniquement (node modules/ask/eval/run.js), pas l'API :
# OPALE_ASK_PROVIDER=mistral
# OPALE_ASK_MODEL=mistral-small-latest
# OPALE_ASK_URL=
# OPALE_ASK_DELAY_MS=14000

# Instance migrée avec des agents historiques encore déployés :
# regex OR-ée au User-Agent Opale pour leur proposer l'auto-update...
# OPALE_LEGACY_AGENT_UA_PATTERN=old-agent-go
# ...et noms de services Windows supplémentaires (CSV, [A-Za-z0-9_-]) pour
# « redémarrer l'agent » via SSH.
# OPALE_LEGACY_AGENT_SERVICE_NAMES=Old-Agent

# Scripts de maintenance (api/scripts/*.js, via docker compose exec) : chaîne de
# connexion Postgres, prioritaire sur POSTGRES_* (DATABASE_URL, sinon PGURL).
# Non lue par l'API elle-même.
# DATABASE_URL=postgres://opale:changeme@db:5432/opale
# PGURL=postgres://opale:changeme@db:5432/opale
# ══ Variables avancées (optionnelles) — fin ═══════════════════════════════════
