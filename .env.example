# ── Serveur ────────────────────────────────────────────────────────────────────
PORT=3010
NODE_ENV=production

# ── Base de données ────────────────────────────────────────────────────────────
POSTGRES_DB=opale
POSTGRES_USER=opale
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db                    # nom du service Docker Compose, ou adresse IP

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://opale.example.com  # utilisé pour CORS
API_BASE_URL=/api                      # injecté dans window.ENV côté client

# ── Reverse proxy ──────────────────────────────────────────────────────────────
# Proxy(s) de confiance pour lire l'IP client dans X-Forwarded-For (rate-limit).
# EN PRODUCTION DERRIÈRE CADDY/NGINX : À DÉFINIR (de fait obligatoire).
# Vide / false (défaut) : req.ip = IP du pair TCP — derrière le proxy, TOUS les
# clients partagent alors l'IP du proxy, donc les mêmes quotas : n'importe qui
# sur Internet peut épuiser le quota de /api/agent/exchange-token (10/min pour
# toute la flotte) et bloquer les enrôlements.
# SÛR UNIQUEMENT si le port 3010 n'est joignable QUE via le proxy : sinon un
# client qui s'y connecte en direct forge X-Forwarded-For. Le docker-compose.yml
# fourni publie 3010 sur TOUTES les interfaces ("3010:3010") : passer à
# "127.0.0.1:3010:3010" (ou filtrer 3010 au pare-feu) avant de l'activer.
# Valeurs : liste d'IP/CIDR du proxy (recommandé ; API en Docker derrière un
# proxy sur l'hôte → IP de la passerelle du bridge Docker vue par l'API, ex.
# 172.18.0.1, ou le sous-réseau du réseau compose ; pas 127.0.0.1). Éviter un
# CIDR large comme 172.16.0.0/12 : un client dont l'IP y tombe pourrait forger
# son IP derrière nginx. true et un nombre de proxies (1) sont refusés au boot :
# ils ne vérifient pas le pair TCP (usurpation, cf. GHSA-3m5p-2c4r-xxw2).
TRUST_PROXY=

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
# App Registration avec permissions Application (pas déléguées). Détail par
# fonctionnalité, appels Graph et durcissement Entra/Exchange : INSTALL.md §3.2.
#   Socle          : User.Read.All
#   Intune         : DeviceManagementManagedDevices.Read.All (import),
#                    DeviceManagementManagedDevices.PrivilegedOperations.All
#                    (bouton « Sync Intune » d'un poste)
#   Groupes Entra  : GroupMember.Read.All + Device.Read.All
#   Onboarding auto: User.ReadWrite.All (création de compte), GroupMember.ReadWrite.All
# Pour le pont mail ↔ tickets (issue #8), ajouter aussi :
#   Mail.Read        (lecture seule) ou Mail.ReadWrite (marquage "lu" + réponses
#                    threadées) — Mail.ReadWrite est un sur-ensemble de Mail.Read
#   Mail.Send        (envoi des réponses)
# Mail.* vaut pour TOUTES les boîtes du tenant : les restreindre aux boîtes du
# helpdesk (RBAC for Applications Exchange Online, cf. INSTALL.md §3.2).
# Consentement admin tenant requis sur ces permissions applicatives.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── SSH ────────────────────────────────────────────────────────────────────────
# Clé privée ED25519 encodée en base64 : base64 -i ~/.ssh/id_ed25519
# Si non défini, l'API émet un warning au boot et utilise le défaut 'opale'.
SSH_USER=opale
SSH_PORT=22
SSH_PRIVATE_KEY_B64=

# ── Push notifications (PWA) ───────────────────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
# VAPID_EMAIL est REQUIS dès lors que les clés VAPID sont définies (fail-fast au boot).
# Format accepté : 'admin@example.com' ou 'mailto:admin@example.com'.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Onboarding ─────────────────────────────────────────────────────────────────
# IDs des groupes Entra à assigner lors de l'onboarding (séparés par des virgules)
ONBOARDING_BASE_GROUP_IDS=
ONBOARDING_LICENSE_GROUP_ID=
