+
+  # ─────────────────────────────────────────────────────────────────────────
+  # 6) Sécurité — audit de dépendances, analyse statique, scan de secrets et
+  #    scan de l'image. Rien de tout cela n'existait : Dependabot ouvrait des
+  #    PR mais ne bloquait aucun merge, et un dépôt qui manipule des clés SSH,
+  #    une clé de signature de binaires et une clé LAPS n'avait ni SAST ni
+  #    détection de secrets.
+  # ─────────────────────────────────────────────────────────────────────────
+  audit-dependencies:
+    name: Audit des dépendances
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+
+      # `--omit=dev` : on bloque sur ce qui part en PRODUCTION. Une
+      # vulnérabilité dans une dépendance de développement ne se retrouve pas
+      # dans l'image publiée ; la signaler sans bloquer garde le signal sans
+      # bloquer les merges sur du bruit.
+      - name: npm audit — dépendances de production de l'API
+        working-directory: api
+        run: npm audit --omit=dev --audit-level=high
+
+      - name: npm audit — vendors front
+        working-directory: front
+        run: npm audit --omit=dev --audit-level=high
+
+      - name: npm audit — outillage (informatif)
+        run: npm audit --audit-level=critical || echo "::warning::vulnérabilités dans l'outillage de dev — à traiter, non bloquant"
+
+      - uses: actions/setup-go@v6
+        with:
+          go-version-file: agent-go/go.mod
+          cache-dependency-path: agent-go/go.sum
+
+      # L'agent tourne en SYSTEM sur tous les postes du parc : c'est le
+      # composant où une vulnérabilité de dépendance coûte le plus cher.
+      - name: govulncheck — agent Go
+        working-directory: agent-go
+        run: |
+          go install golang.org/x/vuln/cmd/govulncheck@latest
+          "$(go env GOPATH)/bin/govulncheck" ./...
+
+  codeql:
+    name: CodeQL (JavaScript, Go)
+    runs-on: ubuntu-latest
+    permissions:
+      security-events: write
+      contents: read
+    strategy:
+      fail-fast: false
+      matrix:
+        language: [javascript-typescript, go]
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: github/codeql-action/init@v3
+        with:
+          language: ${{ matrix.language }}
+          queries: security-extended
+
+      - uses: github/codeql-action/autobuild@v3
+
+      - uses: github/codeql-action/analyze@v3
+        with:
+          category: /language:${{ matrix.language }}
+
+  secret-scan:
+    name: Scan de secrets (gitleaks)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          # Historique complet : un secret committé puis retiré reste
+          # exploitable tant qu'il n'a pas été révoqué. C'est exactement ce
+          # qu'on veut détecter.
+          fetch-depth: 0
+
+      - uses: gitleaks/gitleaks-action@v2
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+
+  image-scan:
+    name: Scan de l'image (Trivy)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: docker/setup-buildx-action@v3
+
+      - name: Build image
+        uses: docker/build-push-action@v5
+        with:
+          context: .
+          load: true
+          tags: opale:scan
+          cache-from: type=gha
+
+      # L'image publiée sur GHCR est installée par des tiers via le one-liner :
+      # elle ne doit pas embarquer de CVE haute ou critique connue.
+      - name: Trivy — vulnérabilités de l'image
+        uses: aquasecurity/trivy-action@0.28.0
+        with:
+          image-ref: opale:scan
+          severity: HIGH,CRITICAL
+          ignore-unfixed: true
+          exit-code: '1'
+          format: table
+
+      # Vérifie le durcissement du Dockerfile lui-même (USER non-root, etc.).
+      - name: Trivy — configuration Docker
+        uses: aquasecurity/trivy-action@0.28.0
+        with:
+          scan-type: config
+          scan-ref: .
+          severity: HIGH,CRITICAL
+          exit-code: '1'
+          format: table
